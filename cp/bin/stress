#!/usr/bin/env bash
# stress sol brute gen.py  -> .py or .cpp for sol/brute; gen takes the seed as argv[1]. N= sets runs.
d=$(mktemp -d); trap 'rm -rf $d' EXIT
build() { case "$1" in
  *.py)  echo "${PY:-pypy3} $1" ;;
  *.cpp) clang++ -I$HOME/cp/include -std=c++20 -O2 -o "$d/$2" "$1" || exit 1; echo "$d/$2" ;;
esac; }
S=$(build "$1" sol); B=$(build "$2" brute)
for i in $(seq 1 ${N:-1000}); do
  python3 "$3" $i > $d/in
  $S < $d/in > $d/o1; $B < $d/in > $d/o2
  if ! cmp -s $d/o1 $d/o2; then echo "DIFF on seed $i"; cp $d/in fail.in; echo "saved fail.in"; exit 1; fi
done
echo "all ${N:-1000} passed"
